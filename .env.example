# Скопируйте этот файл в .env и впишите ключ после знака равно
ANTHROPIC_API_KEY=

# Необязательно
# Модель. Для дешёвых тестов: claude-haiku-5-5, для демо: claude-sonnet-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Экономия токенов
# MAX_TOKENS=8000      потолок длины ответа (по умолчанию 16000)
# MAX_ATTEMPTS=1       без повторного запроса при невалидной игре (по умолчанию 2)
# PORT=3000
