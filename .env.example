# Скопируйте этот файл в .env и впишите свой ключ после знака равно.
# Файл .env не попадает в git. Никому не показывайте ключ.

# Провайдер: openai или anthropic (если не задан, выбирается openai при наличии OPENAI_API_KEY)
LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
# OPENAI_REASONING_EFFORT=medium   (minimal | low | medium | high, влияет на качество и расход)
# OPENAI_BASE_URL=                 (свой шлюз или прокси, по умолчанию https://api.openai.com)

# --- Anthropic (если LLM_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Лимиты токенов ---
# Потолок на одну генерацию, считается по всем попыткам вместе (по умолчанию 5 000 000)
# GENERATION_TOKEN_LIMIT=5000000
# Потолок длины одного ответа модели (по умолчанию: gpt-5 и o-серия 128000, остальные модели 16000)
# MAX_TOKENS=128000
# Общий лимит на всё время работы, расход хранится в .usage.json (по умолчанию без лимита)
# TOKEN_BUDGET=
# Число попыток, если игра не прошла проверку (по умолчанию 3)
# MAX_ATTEMPTS=3

# PORT=3000
