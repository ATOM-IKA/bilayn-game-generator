# Скопируйте этот файл в .env и впишите свой ключ после знака равно.
# Файл .env не попадает в git. Никому не показывайте ключ.

# Провайдер: openai или anthropic (если не задан, выбирается openai при наличии OPENAI_API_KEY)
LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-sol         (по умолчанию; флагман OpenAI: gpt-6-astra, он дороже)
# OPENAI_REASONING_EFFORT=medium   (low | medium | high | xhigh | max; по умолчанию medium. high и выше заметно медленнее и могут не уложиться в 5 минут)
# OPENAI_BASE_URL=                 (свой шлюз или прокси, по умолчанию https://api.openai.com)

# --- Шлюз или прокси (общие имена, работают для любого провайдера) ---
# LLM_API_KEY=         (используется, если не задан OPENAI_API_KEY / ANTHROPIC_API_KEY)
# LLM_BASE_URL=https://ваш-шлюз/   (слэш в конце и /v1 в адресе допустимы)

# --- Anthropic (если LLM_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Качество ---
# max (по умолчанию): дизайн-документ, код по нему, ревью и исправление. Расходует больше токенов и времени
# standard: один запрос на игру, быстрее и дешевле
# QUALITY=max

# --- Лимиты токенов ---
# Потолок на одну генерацию, считается по всем попыткам вместе (по умолчанию 5 000 000)
# GENERATION_TOKEN_LIMIT=5000000
# Потолок длины одного ответа модели (по умолчанию: модели с рассуждением 128000, остальные 16000)
# MAX_TOKENS=128000
# Общий лимит на всё время работы, расход хранится в .usage.json (по умолчанию без лимита)
# TOKEN_BUDGET=
# Общий лимит времени на одну генерацию в миллисекундах (по умолчанию 300000 = 5 минут)
# GENERATION_TIMEOUT_MS=300000
# Число попыток, если игра не прошла проверку (по умолчанию 3)
# MAX_ATTEMPTS=3

# PORT=3000
